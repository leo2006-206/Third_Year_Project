# ==============================================================================
# Dockerfile for OBM Offload Server Node
# Co-located Rust Offload Server & Dana Offload Engine (Port 9009)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Download the Dana runtime (pinned version + checksum)
# projectdana.com serves an incomplete TLS chain, so curl uses -k;
# integrity is instead guaranteed by the pinned SHA-256 below.
# ------------------------------------------------------------------------------
FROM ubuntu:22.04 AS dana_download

ARG DANA_VERSION=273
ARG DANA_SHA256=81d71801e4048a3c5eb76fca309ad62cbfdb95adc1fd5abf0f6210e28f7f40ce

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSLk -o /tmp/dana.zip "https://www.projectdana.com/download/ubu_x86-64/${DANA_VERSION}" \
    && echo "${DANA_SHA256}  /tmp/dana.zip" | sha256sum -c - \
    && mkdir -p /opt/dana \
    && unzip -q /tmp/dana.zip -d /opt/dana \
    && chmod 755 /opt/dana/dana /opt/dana/dnc \
    && rm -f /tmp/dana.zip

# ------------------------------------------------------------------------------
# Stage 2: Offload server image
# ------------------------------------------------------------------------------
FROM ubuntu:22.04

# Prevent interactive dialogs during apt installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential runtime dependencies for Dana (Mesa/GL for rendering, VA-API for hardware acceleration) and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libgl1 \
    libglu1-mesa \
    libgl1-mesa-dri \
    mesa-utils \
    xvfb \
    libva2 \
    libva-drm2 \
    libvdpau1 \
    libopus0 \
    libxtst6 \
    libxv1 \
    vainfo \
    intel-media-va-driver-non-free \
    mesa-va-drivers \
    && curl -fsSL -o /tmp/virtualgl.deb https://github.com/VirtualGL/virtualgl/releases/download/3.1.5/virtualgl_3.1.5_amd64.deb \
    && dpkg -i /tmp/virtualgl.deb \
    && rm -f /tmp/virtualgl.deb \
    && rm -rf /var/lib/apt/lists/*

# Set up Dana environment variables
ENV DANA_HOME=/opt/dana
ENV PATH="${PATH}:${DANA_HOME}"

# Copy Dana runtime engine and standard components from the download stage (cached permanently)
WORKDIR /opt/dana
COPY --from=dana_download /opt/dana/ /opt/dana/

# Patch Dana UIPlaneLib default window size from 640x480 to target 1280x720 (0x0280x01e0 -> 0x0500x02d0).
# This guarantees 1:1 OpenGL viewport and projection matrix alignment from initialization,
# preventing viewport squashing, memory readback noise, and inverted texture blitting under Xvfb/Mesa.
# Fails the build if the byte pattern is not found exactly once (e.g. a Dana update changed the library).
RUN perl -0777 -pi -e '$n = s/\x48\xb9\x80\x02\x00\x00\xe0\x01\x00\x00/\x48\xb9\x00\x05\x00\x00\xd0\x02\x00\x00/g; die "UIPlaneLib patch matched $n times (expected 1)\n" unless $n == 1' \
    /opt/dana/components/resources-ext/UIPlaneLib\[deb.x64\].dnl

# Set working directory to the OBM application root
WORKDIR /app/obm

# Copy OBM runtime code, components, and tools (FAST: ~64MB, NO assets or shows)
COPY obm/components/ /app/obm/components/
COPY obm/media/ /app/obm/media/
COPY obm/resources/ /app/obm/resources/
COPY obm/resources-ext/ /app/obm/resources-ext/
COPY obm/std_ui/ /app/obm/std_ui/
COPY obm/tools/ /app/obm/tools/
COPY obm/ws/ /app/obm/ws/
COPY obm/*.* obm/Makefile /app/obm/

# Target port for the co-located Rust Offload Server (default: 7010)
ARG PORT=7010
ENV OFFLOAD_PORT=${PORT}

# Copy customized OffloadSite_new.dn with timing instrumentation
COPY servers_container/offload_server/OffloadSite_new.dn /app/obm/OffloadSite_new.dn

# Update ASSET_HOST in OffloadSite_new.dn to point to the Rust server port and compile OffloadSite_new.o + VA-API hardware decoder
RUN sed -i "s|http://localhost:8080/|http://localhost:${OFFLOAD_PORT}/|g" /app/obm/OffloadSite_new.dn && \
    cd /app/obm && \
    dnc OffloadSite_new.dn && \
    dnc media/video/Decoder.h264va.dn

# Copy pre-compiled Rust offload_server binary
COPY --chmod=755 target/release/offload_server /usr/local/bin/offload_server

# Copy entrypoint script for launching both processes and handling signals cleanly
COPY --chmod=755 servers_container/offload_server/entrypoint.sh /usr/local/bin/entrypoint.sh

# Expose ONLY the Rust Offload Server port (Dana OffloadSite runs internally on 9009)
EXPOSE 7010

# Use entrypoint to run both Dana OffloadSite and Rust offload_server
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
