# ==============================================================================
# Dockerfile for OBM Offload Server Node
# Co-located Rust Offload Server & Dana Offload Engine (Port 9009)
# ==============================================================================
FROM ubuntu:22.04

# Prevent interactive dialogs during apt installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential runtime dependencies for Dana (Mesa/GL for rendering, VA-API for hardware acceleration) and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    libgl1 \
    libglu1-mesa \
    libgl1-mesa-dri \
    mesa-utils \
    xvfb \
    libva2 \
    libva-drm2 \
    libvdpau1 \
    libopus0 \
    vainfo \
    intel-media-va-driver-non-free \
    mesa-va-drivers \
    && rm -rf /var/lib/apt/lists/*

# Set up Dana environment variables
ENV DANA_HOME=/opt/dana
ENV PATH="${PATH}:${DANA_HOME}"

# Copy Dana runtime engine and standard components (cached permanently)
WORKDIR /opt/dana
COPY --chmod=755 servers_container/dana_runtime_copy/ /opt/dana/

# Patch Dana UIPlaneLib default window size from 640x480 to target 1280x720 (0x0280x01e0 -> 0x0500x02d0).
# This guarantees 1:1 OpenGL viewport and projection matrix alignment from initialization,
# preventing viewport squashing, memory readback noise, and inverted texture blitting under Xvfb/Mesa.
RUN perl -0777 -pi -e 's/\x48\xb9\x80\x02\x00\x00\xe0\x01\x00\x00/\x48\xb9\x00\x05\x00\x00\xd0\x02\x00\x00/g' \
    /opt/dana/components/resources-ext/UIPlaneLib\[deb.x64\].dnl

# Set working directory to the OBM application root
WORKDIR /app/obm

# Copy OBM runtime code, components, and tools (FAST: ~64MB, NO assets or shows)
COPY obm/components/ /app/obm/components/
COPY obm/media/ /app/obm/media/
COPY obm/resources/ /app/obm/resources/
COPY obm/resources-ext/ /app/obm/resources-ext/
COPY obm/std_ui/ /app/obm/std_ui/
COPY obm/tools/ /app/obm/tools/
COPY obm/ws/ /app/obm/ws/
COPY obm/*.* obm/Makefile /app/obm/

# Target port for the co-located Rust Offload Server (default: 7010)
ARG PORT=7010
ENV OFFLOAD_PORT=${PORT}

# Update ASSET_HOST in OffloadSite.dn to point to the Rust server port and compile OffloadSite.o + VA-API hardware decoder
RUN sed -i "s|http://localhost:8080/|http://localhost:${OFFLOAD_PORT}/|g" /app/obm/OffloadSite.dn && \
    cd /app/obm && \
    dnc OffloadSite.dn && \
    dnc media/video/Decoder.h264va.dn

# Copy pre-compiled Rust offload_server binary
COPY --chmod=755 servers_rust/target/release/offload_server /usr/local/bin/offload_server

# Copy entrypoint script for launching both processes and handling signals cleanly
COPY --chmod=755 servers_container/offload_server/entrypoint.sh /usr/local/bin/entrypoint.sh

# Expose ONLY the Rust Offload Server port (Dana OffloadSite runs internally on 9009)
EXPOSE 7010

# Use entrypoint to run both Dana OffloadSite and Rust offload_server
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
