//input format: /offload/show/<showname>/<timefrom_s>/<timeto_s>/<resolution_x>/<resolution_y>/<variant_name>/<layerCount>/<layer_name>:<option>/<layer_name>:<option>/etc...

// dana OffloadSite -req "/offload/show/f1_full.json/0/10/1280/720/race/landscape/4/race|race/driver|Sam/track|track/drivers|Sam,Alex" -out test.h264 -bitrate 4096
// dana OffloadSite -req "/offload/show/f1_full.json/0/10/1920/1080/race/landscape/4/race|race/driver|Sam/track|track/drivers|Sam,Alex" -out test.h264 -bitrate 4096

// with hardware codec:
// dana -lc "media.video.Encoder:h264|media/video/Encoder.h264va.o|media.video.Encoder:h264va" -lc "media.video.Decoder:h264|media/video/Decoder.h264va.o|media.video.Decoder:h264va" OffloadSite -req "/offload/show/f1_full.json/0/10/1920/1080/race/landscape/4/race|race/driver|Sam/track|track/drivers|Sam,Alex,Smith,Schmidt,Rossi,Garcia,Martin" -out test_seg_0_10.h264

// dana -lc "media.video.Encoder:h264|media/video/Encoder.h264va.o|media.video.Encoder:h264va" -lc "media.video.Decoder:h264|media/video/Decoder.h264va.o|media.video.Decoder:h264va" OffloadSite -req "/offload/show/forest720_leaves.json/0/10/1920/1080/core/landscape/5/background|background_default/creature|creature_default/creature_alpha|alpha/bird|bird_default/bird_alpha|alpha/near_forest|near_default/near_alpha|alpha/leaves|leaves_default/leaves_alpha|alpha" -out test_seg_0_10.h264

// dana -lc "media.video.Encoder:h264|media/video/Encoder.h264va.o|media.video.Encoder:h264va" -lc "media.video.Decoder:h264|media/video/Decoder.h264va.o|media.video.Decoder:h264va" OffloadSite -req "/offload/show/forecast.json/0/10/1920/1080/core/landscape/4/map|map_colour/weather|Meteorological/presenter|hearing/presenter_chroma|chroma/time|time" -out test_seg_0_10.h264

uses media.video.H264Parser
uses media.PixelFormat
uses ui.Rect2D
uses ui.Color

const int INACTIVE_WAIT_MS = 10
const int RESOURCE_TIMEOUT_MS = 60000 // generous: far sites (netem 100ms) need ~2-5s+ to fetch assets

const int SEG_SIZE = 10
const int FPS = 25

//const int BITRATE_DEFAULT = 4096
const int BITRATE_DEFAULT = 2048
//const int BITRATE_DEFAULT = 1024

data RenderLayer {
	char name[]
	String options[]
}

data RenderConfig {
	char variantName[]
	char styleName[]
	int renderLayerCount
	RenderLayer layers[]
	// PSC PoC: first offloadLayerCount roots come from a cached sub segment (Track:offload via ASSET_HOST), 0 = render all
	int offloadLayerCount
	// PSC pair: "<k>*<n>" = render n roots once, ALSO output roots 0..k-1 as a sub segment; 0 = off
	int pairLayerCount
}

data RenderTask {
	char showID[]
	int timeFrom
	int timeTo
	int screenWidth
	int screenHeight
	int bitrate

	const byte M_INIT = 1
	const byte M_CONFIGURE = 2
	const byte M_RENDER = 3
	byte mode

	TCPSocket socket
	File file
	Experience exp
	VariantInfo variants[]
	Encoder encoder
	List frames

	RenderConfig config

	int t_arrive
	int t_queue
	int t_asset_start
	int t_asset
	int t_work
	int t_decode
	int t_render
	int t_encode

	// PSC pair: encoder B makes the sub segment
	Encoder encoderSub
	List framesSub
	ChunkList subChunks
	int t_render_sub
	int t_encode_sub
}

data ChunkList {
	List list
	int length
}

data Chunk {
	byte content[]
}

//this is a custom header injected into an otherwise H264 annex-b formatted stream, to avoid seeking for frame synch markers
data H2iHeader {
	int4 length
	byte type
}

const int M_LISTEN = 1
const int M_DIRECT = 2

const char ASSET_HOST[] = "http://localhost:8080/"

component provides App requires io.Output out, data.StringUtil stringUtil, data.IntUtil iu, util.ParamParser, net.TCPServerSocket, net.TCPSocket, io.File, data.adt.Queue, data.adt.List, time.Timer timer, ui.FlowRender, ui.FlowCanvas, ui.FlowFont, Experience, media.video.Encoder:av1, media.video.Encoder:h264, media.video.VideoFile:divf ivfVideo, data.StreamBuffer, data.query.Search search, media.image.ImageTransform, time.Calendar cal, media.video.H264Parser hParser {

	Queue requests
	List pending
	bool USE_IHDR = true
	byte opMode = M_LISTEN
	bool quit
	ImageTransform imgTransform
	char directOut[]

	bool processEvents(FlowEvent events[])
		{
		bool q = false
		
		for (int i = 0; i < events.arrayLength; i++)
			{
			if (events[i].type == FlowEvent.T_QUIT)
				{
				q = true
				}
			}
		
		return q
		}
	
	// -- H264 helpers -- 
	byte getFrameType(byte content[], int offset, int smlen)
		{
		byte b = content[offset + smlen]
		if ((content[offset + smlen] & 0x1F) == 0x7)
			{
			return NALFrame.T_HEADER_SPS
			}
			else if ((content[offset + smlen] & 0x1F) == 0x6)
			{
			return NALFrame.T_HEADER_SEI
			}
			else if ((content[offset + smlen] & 0x1F) == 0x8)
			{
			return NALFrame.T_HEADER_PPS
			}
			else if ((content[offset + smlen] & 0x1F) == 0x5)
			{
			return NALFrame.T_FRAME_I
			}
			else if ((content[offset + smlen] & 0x1F) == 0x1)
			{
			return NALFrame.T_FRAME_P
			}
			else
			{
			
			}
		
		return NALFrame.T_UNKNOWN
		}
	
	int isStartMarker(byte content[], int offset)
		{
		if ((offset + 4) < content.arrayLength)
			{
			if (content[offset] == 0 && content[offset+1] == 0 && content[offset+2] == 0 && content[offset+3] == 1)
				{
				return 4
				}
				else if (content[offset] == 0 && content[offset+1] == 0 && content[offset+2] == 1)
				{
				return 3
				}
			}
			else if ((offset + 3) < content.arrayLength)
			{
			if (content[offset] == 0 && content[offset+1] == 0 && content[offset+2] == 1)
				{
				return 3
				}
			}
		
		return 0
		}
	
	// -/ H264 helpers /- 

	void work(Experience exp, int start, int end)
		{
		exp.batchPrepPost(start, end)
		}

	int App:main(AppParam params[])
		{
		char ipAddress[] = TCPServerSocket.ANY_ADDRESS
		int port = 9009
		bool batchMode = false

		ParamParser pparse = new ParamParser(params, new String[](new String("-raw"), new String("-batch")))

		TCPServerSocket restListener
		requests = new Queue()
		pending = new List()

		if (params.arrayLength == 0)
			{
			//normal REST responsive mode
			restListener = new TCPServerSocket()
			if (!restListener.bind(ipAddress, port, true)) return 1
			asynch::serverThread(restListener)
			}
			else
			{
			//immediate mode, with request given on command line, and result written to file
			char req[] = pparse.getValue("-req")
			char output[] = pparse.getValue("-out")
			char bitrate[] = pparse.getValue("-bitrate")
			int br = 0

			if (bitrate == null)
				br = BITRATE_DEFAULT
				else
				br = bitrate.intFromString()

			if (req == null || output == null)
				{
				out.println("must specify -req and -out values")
				return 1
				}
			
			opMode = M_DIRECT
			if (pparse.hasSwitch("-raw")) USE_IHDR = false
			if (pparse.hasSwitch("-batch")) batchMode = true

			String parts[] = req.explode("/")

			File fd = new File(output, File.CREATE)
			directOut = output

			char err[] = queueRequest(parts, null, fd, br)
			if (err != null)
				{
				out.println("bad request: $(err)")
				fd.close()
				return 1
				}
			}

		FlowRender window = new FlowRender(25)
		FlowCanvas canvas = new FlowCanvas(window)
		byte pixelFormat = window.getPixelFormat()

		EncodedFrame framesEnc[] = null
		int reqHandled = 0
		int lastStaleCheck = cal.getMS()

		while (!quit)
			{
			RenderTask rt = requests.service()
			if (rt != null)
				{
				//TODO: check for cache (or CDN?) presence of this segment

				if (rt.mode == RenderTask.M_INIT)
					{
					if (rt.t_queue == 0)
						rt.t_queue = cal.getMS() - rt.t_arrive
					rt.t_asset_start = cal.getMS()
					rt.exp = new Experience(new WH(rt.screenWidth, rt.screenHeight), ASSET_HOST, "shows/$(rt.showID)")
					sinkevent ExpEvents(rt.exp)

					pending.add(rt)
					rt.exp.downloadSpec()
					}
					else if (rt.mode == RenderTask.M_RENDER)
					{
					out.println(" -- starting render at resolution $(rt.screenWidth)x$(rt.screenHeight)")

					imgTransform = new ImageTransform(new WH(rt.screenWidth, rt.screenHeight))

					rt.variants = rt.exp.getVariants()
					if (rt.config.offloadLayerCount > 0)
						rt.exp.loadVariant(rt.config.variantName, rt.config.styleName, offloadLayers = rt.config.offloadLayerCount, renderLayers = rt.config.renderLayerCount)
						else
						rt.exp.loadVariant(rt.config.variantName, rt.config.styleName, renderLayers = rt.config.renderLayerCount)

					//at the moment we need to keep calling resource() until it's true, to get the variant loaded
					// - this means we're going to be pulling in source resources that we'll throw away if we change layer options...
					// - so maybe we should be allowed to pick layer options for an in-progress variant load...

					out.println("   - waiting for variant ready")

					int timeStart = rt.timeFrom
					int timeEnd = timeStart + SEG_SIZE
					int frameStart = timeStart * FPS
					int frameEnd = (timeEnd * FPS) - 1

					for (int i = 0; i < rt.variants.arrayLength; i++)
						{
						if (rt.variants[i].name == rt.config.variantName && (rt.config.styleName == null || rt.variants[i].style == null || rt.variants[i].style == rt.config.styleName))
							{
							if (rt.variants[i].lengthFrames > 0 && frameEnd >= rt.variants[i].lengthFrames)
								{
								frameEnd = rt.variants[i].lengthFrames - 1
								}
							break
							}
						}

					int frameCount = 0
					int frameIndex = frameStart

					int initTimeTaken = 0
					// an exception inside Experience (layer count > roots, empty layout download, ...) makes resource() return null; the old
					// '!rinfo.ready' then threw in main = render loop dead, process alive, site hung (kb/partial_segment.md 16, P1)
					ResourceInfo rinfo = rt.exp.resource(window, frameIndex)
					//out.println("[ready-check: $(rinfo.ready)]")
					while (rinfo != null && !rinfo.ready)
						{
						timer.sleep(INACTIVE_WAIT_MS)
						initTimeTaken += INACTIVE_WAIT_MS
						if (initTimeTaken >= RESOURCE_TIMEOUT_MS)
							{
							out.println(" -- timeout waiting for initial resources")
							break
							}
						rinfo = rt.exp.resource(window, frameIndex)
						}
					if (rinfo == null || !rinfo.ready)
						{
						if (rinfo == null)
							failTask(rt, 500, "Internal Server Error", "render setup failed (layer count larger than the variant's roots, or a show / asset download failed)")
							else
							failTask(rt, 504, "Gateway Timeout", "timeout waiting for initial resources")
						quit = true
						if (restListener != null) restListener.unbind()
						if (opMode == M_DIRECT) return 1
						return 0
						}
					// asset time ends here, not at variantReady: the requested layer options' resources
					// are only fetched after it (setLayerOptions + showVariant), in the loop above
					rt.t_asset = cal.getMS() - rt.t_asset_start

					//out.println("   - setting layer options")
					
					//out.println("   - waiting for resources at 0")
					
					window.setSize(rt.screenWidth, rt.screenHeight)
					//rt.encoder = new Encoder:av1(new WH(rt.screenWidth, rt.screenHeight), FPS)
					//rt.encoder = new Encoder:h264(new WH(rt.screenWidth, rt.screenHeight), FPS, new KeyValue("bitrate", "2048"))
					rt.encoder = new Encoder:h264(new WH(rt.screenWidth, rt.screenHeight), FPS)
					rt.frames = new List()

					int pairK = rt.config.pairLayerCount
					if (pairK > 0)
						{
						rt.encoderSub = new Encoder:h264(new WH(rt.screenWidth, rt.screenHeight), FPS)
						rt.framesSub = new List()
						}

					bool keyFrame = true

					//out.println("   - seeking to $(frameIndex)")
					
					//rt.exp.seek(window, frameIndex)

					//out.println("   - waiting for resources at $(frameIndex)")

					int start_ms = cal.getMS()

					int batchSize = 50
					int threadPoolSize = 5
					Thread workers[] = new Thread[threadPoolSize]
					if (batchMode) rt.exp.batchInit(batchSize) //maybe this only actually applies to transform layers (and their child layers) ???

					bool timeout = false
					while (frameIndex != (frameEnd+1) && !timeout)
						{
						int timeTaken = 0
						rinfo = rt.exp.resource(window, 0)
						//out.println("[ready-check: $(rinfo.ready)]")
						while (rinfo != null && !rinfo.ready)
							{
							timer.sleep(INACTIVE_WAIT_MS)
							timeTaken += INACTIVE_WAIT_MS

							if (timeTaken >= RESOURCE_TIMEOUT_MS)
								{
								timeout = true
								break
								}
							// ask again (the loop never re-asked: one not-ready frame always ran into the 60 s timeout)
							rinfo = rt.exp.resource(window, 0)
							}
						if (rinfo == null) timeout = true
						
						if (!timeout)
							{
							//render the time segment
							if (!batchMode)
								{
								int t_dec = cal.getMS()
								rt.exp.prepare(window, frameIndex)
								rt.t_decode += cal.getMS() - t_dec

								if (pairK > 0)
									{
									// PSC pair, step 1: bottom roots 0..k-1 only
									int t_rs = cal.getMS()
									canvas.rect(new Rect2D(0, 0, rt.screenWidth, rt.screenHeight, new Color(0, 0, 0, 255)))
									rt.exp.renderRange(canvas, 0, pairK)
									rt.t_render_sub += cal.getMS() - t_rs
									rt.t_render += cal.getMS() - t_rs

									// step 2: read back the bottom picture -> encoder B
									int t_es = cal.getMS()
									PixelMap pixelsSub = window.getPixels(pixelFormat)
									PixelMapYUV yuvSub = imgTransform.rgbaToYUV(pixelsSub, pixelFormat)
									EncodedFrame encSub[] = rt.encoderSub.encode(yuvSub, keyFrame)
									for (int i = 0; i < encSub.arrayLength; i++)
										{
										rt.framesSub.add(encSub[i])
										}
									rt.t_encode_sub += cal.getMS() - t_es

									// step 3: roots k..n-1 straight onto the window, on top, no clear (encoder A below = the full)
									int t_rt = cal.getMS()
									rt.exp.renderRange(canvas, pairK, rt.config.renderLayerCount, true)
									rt.t_render += cal.getMS() - t_rt
									}
									else
									{
									int t_rnd = cal.getMS()
									canvas.rect(new Rect2D(0, 0, rt.screenWidth, rt.screenHeight, new Color(0, 0, 0, 255)))
									rt.exp.render(canvas)
									rt.t_render += cal.getMS() - t_rnd
									}
								}
								else
								{
								//if we're in a new 50-frames chunk (or whatever we set this chunk size as):
								if ((frameIndex % batchSize) == 0)
									{
									//out.println("batch pre-prep")
									int t_dec = cal.getMS()
									rt.exp.batchPrepPre(window, 50)
									int start = frameIndex
									int len = 10
									//out.println("worker threads launch")
									for (int i = 0; i < workers.arrayLength; i++)
										{
										workers[i] = asynch::work(rt.exp, start, start + len)
										start += len
										}
									
									//out.println("worker threads joining...")
									for (int i = 0; i < workers.arrayLength; i++)
										{
										workers[i].join()
										}
									rt.t_decode += cal.getMS() - t_dec
									//out.println("worker threads joined")
									}

								int t_rnd = cal.getMS()
								canvas.rect(new Rect2D(0, 0, rt.screenWidth, rt.screenHeight, new Color(0, 0, 0, 255)))
								rt.exp.batchRenderFrame(canvas, frameIndex)
								rt.t_render += cal.getMS() - t_rnd
								}
							
							int t_enc = cal.getMS()
							PixelMap pixels = window.getPixels(pixelFormat)
							PixelMapYUV pixelsYUV = imgTransform.rgbaToYUV(pixels, pixelFormat)
							framesEnc = rt.encoder.encode(pixelsYUV, keyFrame)
							for (int i = 0; i < framesEnc.arrayLength; i++)
								{
								rt.frames.add(framesEnc[i])
								}
							rt.t_encode += cal.getMS() - t_enc
							keyFrame = false
							frameIndex ++
							out.print("\rframe $(frameIndex)/$(frameEnd)")
							frameCount ++
							}
							else
							{
							out.println("\r -- timeout :-(")
							}
						
						if (processEvents(window.getEvents()))
							{
							quit = true
							restListener.unbind()
							return 0
							}
						}
					
					//out.println("\r -- render complete for $(frameCount) frames")

					if (!timeout)
						{
						//out.println(" -- finishing encoding, $(rt.frames.getLength()) frames so far")

						int t_enc_fin = cal.getMS()
						framesEnc = rt.encoder.finish()
						for (int i = 0; i < framesEnc.arrayLength; i++)
							{
							rt.frames.add(framesEnc[i])
							}
						rt.t_encode += cal.getMS() - t_enc_fin

						if (pairK > 0)
							{
							int t_es_fin = cal.getMS()
							framesEnc = rt.encoderSub.finish()
							for (int i = 0; i < framesEnc.arrayLength; i++)
								{
								rt.framesSub.add(framesEnc[i])
								}
							rt.subChunks = wrapFrames(rt.framesSub)
							rt.t_encode_sub += cal.getMS() - t_es_fin
							}
						
						//out.println(" -- wrapping $(rt.frames.getLength()) encoded frames ($(frames.arrayLength) from finish)")

						//send response, as an IVF segment
						List list = new List()
						int totalLength = 0
						StreamBuffer sbuf = new StreamBuffer()
						frameIndex = frameStart
						
						H2iHeader ihdr = new H2iHeader()
						byte hstream[] = dana.serial(ihdr)
						for (EncodedFrame frame = rt.frames.getFirst(); frame != null; frame = rt.frames.getNext())
							{
							//Chunk nc = new Chunk(ivfVideo.writeFrame(new VideoFrame(frame.content, 0, frameIndex)))
							
							if (USE_IHDR)
								{
								ihdr.length = frame.content.arrayLength - 1
								ihdr.type = getFrameType(frame.content, 0, isStartMarker(frame.content, 0))
								//out.println("frame type $(ihdr.type) length $(ihdr.length)")
								list.add(new Chunk(clone hstream))
								totalLength += hstream.arrayLength
								}

							Chunk nc = new Chunk(frame.content)
							list.add(nc)
							totalLength += frame.content.arrayLength
							
							frameIndex ++
							}
						
						int end_ms = cal.getMS()
						rt.t_work = end_ms - start_ms
						
						out.println("\n -- render/encode took $(rt.t_work)ms (queue: $(rt.t_queue)ms, asset: $(rt.t_asset)ms, decode: $(rt.t_decode)ms, render: $(rt.t_render)ms, encode: $(rt.t_encode)ms)")
						if (pairK > 0)
							out.println(" -- pair sub ($(pairK) roots): $(rt.subChunks.length) bytes, render_sub: $(rt.t_render_sub)ms, encode_sub: $(rt.t_encode_sub)ms")
						out.println(" -- sending response")

						if (opMode == M_LISTEN)
							{
							//sendDataChunks(rt.socket, "av1", totalLength, list)
							sendDataChunks(rt, "h264", totalLength, list)
							rt.socket.disconnect()
							//TODO: add segment to cache/CDN?
							}
							else if (opMode == M_DIRECT)
							{
							writeDataChunks(rt.file, "h264", totalLength, list)
							if (pairK > 0)
								writeDataChunks(new File("$(directOut).sub.h2i", File.CREATE), "h264", rt.subChunks.length, rt.subChunks.list)
							}

						reqHandled ++
						// PSC pair: Dana keeps ~0.5 GB more resident after a pair (allocator retention) -> recycle right after it
						if (pairK > 0) reqHandled = 10
						if (opMode == M_LISTEN && reqHandled >= 10 && requests.getLength() == 0 && pending.getLength() == 0)
							{
							out.println(" -- handled $(reqHandled) requests, queue empty, recycling Dana worker...")
							quit = true
							restListener.unbind()
							return 0
							}
						}
						else
						{
						// was: disconnect without a reply (the front resent the job up to 20x; direct mode disconnected a null socket)
						out.println(" -- timeout in resourcing")
						failTask(rt, 504, "Gateway Timeout", "timeout or failure while resourcing frame $(frameIndex)")
						quit = true
						if (restListener != null) restListener.unbind()
						if (opMode == M_DIRECT) return 1
						return 0
						}
					
					if (opMode == M_DIRECT)
						{
						quit = true
						return 0
						}
					}
				}
				else
				{
				if (processEvents(window.getEvents()))
					{
					quit = true
					restListener.unbind()
					return 0
					}

				// a show spec that never arrives (unknown show, failed download) emits no event: fail the task after RESOURCE_TIMEOUT_MS
				// (checked once a second, on a snapshot of the list: the event threads walk 'pending' too)
				if (cal.getMS() - lastStaleCheck >= 1000)
					{
					lastStaleCheck = cal.getMS()
					Data waiting[] = pending.getContents()
					for (int i = 0; i < waiting.arrayLength; i++)
						{
						RenderTask w = waiting[i]
						int age = lastStaleCheck - w.t_arrive
						if (w.mode == RenderTask.M_INIT && age >= RESOURCE_TIMEOUT_MS)
							{
							failTask(w, 504, "Gateway Timeout", "show spec not received (unknown show or download failed)")
							quit = true
							if (restListener != null) restListener.unbind()
							if (opMode == M_DIRECT) return 1
							return 0
							}
						}
					}

				timer.sleep(INACTIVE_WAIT_MS)
				}
			}

		return 0
		}
	
	void sendData(TCPSocket socket, char contentType[], char content[])
		{
		int len = content.arrayLength
		
		socket.send("HTTP/1.0 200 OK\r\n")
		socket.send("Server: Media Offload Server 0.1\r\n")
		socket.send("Content-length: $len\r\n")
		socket.send("Content-type: $contentType\r\n")
		socket.send("Connection: close\r\n")
		socket.send("\r\n")
		
		socket.send(content)
		}
	
	int findex = 0
	void sendDataChunks(RenderTask rt, char contentType[], int len, List chunks)
		{
		int subLen = 0
		if (rt.subChunks != null) subLen = rt.subChunks.length
		rt.socket.send("HTTP/1.0 200 OK\r\n")
		rt.socket.send("Server: Media Offload Server 0.1\r\n")
		rt.socket.send("Content-length: $(len + subLen)\r\n")
		// PSC pair: body = full (len bytes) then sub (subLen bytes)
		if (rt.subChunks != null) rt.socket.send("X-PSC-Sub-Length: $(subLen)\r\n")
		rt.socket.send("Content-type: $contentType\r\n")
		// PSC pair: + render_sub (bottom roots; part of render) and encode_sub (read-back + YUV + encoder B; NOT in encode; work includes it)
		char subT[] = ""
		char subST[] = ""
		if (rt.subChunks != null)
			{
			subT = ";render_sub=$(rt.t_render_sub);encode_sub=$(rt.t_encode_sub)"
			subST = ", render_sub;dur=$(rt.t_render_sub), encode_sub;dur=$(rt.t_encode_sub)"
			}
		rt.socket.send("X-Dana-Timings: queue=$(rt.t_queue);asset=$(rt.t_asset);work=$(rt.t_work);decode=$(rt.t_decode);render=$(rt.t_render);encode=$(rt.t_encode)$(subT)\r\n")
		rt.socket.send("Server-Timing: queue;dur=$(rt.t_queue), asset;dur=$(rt.t_asset), work;dur=$(rt.t_work), decode;dur=$(rt.t_decode), render;dur=$(rt.t_render), encode;dur=$(rt.t_encode)$(subST)\r\n")
		rt.socket.send("Access-Control-Expose-Headers: X-Dana-Timings, Server-Timing\r\n")
		rt.socket.send("Connection: close\r\n")
		rt.socket.send("\r\n")
		
		//File fd = new File("offload_video_$(findex).h264", File.CREATE)
		for (Chunk c = chunks.getFirst(); c != null; c = chunks.getNext())
			{
			rt.socket.send(c.content)
			//fd.write(c.content)
			}
		if (rt.subChunks != null)
			{
			for (Chunk c = rt.subChunks.list.getFirst(); c != null; c = rt.subChunks.list.getNext())
				{
				rt.socket.send(c.content)
				}
			}
		//fd.close()
		//findex ++
		}
	
	// PSC pair: encoded sub frames -> chunks, each with an H2i header (the format Track:offload reads)
	ChunkList wrapFrames(List frames)
		{
		ChunkList cl = new ChunkList(new List(), 0)
		H2iHeader ihdr = new H2iHeader()
		for (EncodedFrame frame = frames.getFirst(); frame != null; frame = frames.getNext())
			{
			ihdr.length = frame.content.arrayLength - 1
			ihdr.type = getFrameType(frame.content, 0, isStartMarker(frame.content, 0))
			byte hstream[] = dana.serial(ihdr)
			cl.list.add(new Chunk(clone hstream))
			cl.length += hstream.arrayLength
			cl.list.add(new Chunk(frame.content))
			cl.length += frame.content.arrayLength
			}
		return cl
		}

	void writeDataChunks(File fd, char contentType[], int len, List chunks)
		{
		for (Chunk c = chunks.getFirst(); c != null; c = chunks.getNext())
			{
			fd.write(c.content)
			}
		fd.close()
		}
	
	eventsink ExpEvents(EventData ed)
		{
		if (ed.type == Experience.[specReady])
			{
			out.println("[event::specReady]")
			for (RenderTask rt = pending.getFirst(); rt != null; rt = pending.getNext())
				{
				if (rt.exp === ed.source)
					{
					//rt.mode = RenderTask.M_CONFIGURE
					rt.mode = RenderTask.M_RENDER
					requests.add(rt)

					out.println(" -- spec completed")

					return
					}
				}
			}
			else if (ed.type == Experience.[variantReady])
			{
			out.println("[event::variantReady]")
			for (RenderTask rt = pending.getFirst(); rt != null; rt = pending.getNext())
				{
				if (rt.exp === ed.source)
					{
					int timeStart = rt.timeFrom
					int timeEnd = timeStart + SEG_SIZE
					int frameStart = timeStart * FPS
					int frameEnd = (timeEnd * FPS) - 1

					int frameCount = 0
					int frameIndex = frameStart

					// match name AND style like the M_RENDER loop: by name only, a portrait request got the landscape
					// VariantInfo and its layer options were silently dropped (kb/partial_segment.md 16, P2)
					VariantInfo vi = null
					for (int vx = 0; vx < rt.variants.arrayLength; vx++)
						{
						if (rt.variants[vx].name == rt.config.variantName && (rt.config.styleName == null || rt.variants[vx].style == null || rt.variants[vx].style == rt.config.styleName))
							{
							vi = rt.variants[vx]
							break
							}
						}
					for (int i = 0; i < rt.config.layers.arrayLength; i++)
						{
						LayerInfo li = vi.layers.findFirst(LayerInfo.[name], new LayerInfo(name = rt.config.layers[i].name))
						rt.exp.setLayerOptions(li, rt.config.layers[i].options, frameIndex)
						}

					rt.exp.showVariant()

					pending.remove(rt)

					out.println(" -- configure completed")

					return
					}
				}
			}
		}
	
	String[] readHeaders(TCPSocket socket)
		{
		String headers[]
		
		char buf[]
		char last4[] = new char[4]
		
		while (last4 != "\r\n\r\n")
			{
			char b[] = socket.recv(1)
			if (b.arrayLength == 0) break
			buf = new char[](buf, b)
			last4[0] = last4[1]
			last4[1] = last4[2]
			last4[2] = last4[3]
			last4[3] = b[0]
			}
		
		headers = stringUtil.explode(buf, "\r\n")
		
		return headers
		}
	
	// digits only (no sign, no trailing text), 1..maxDigits long
	bool isNumber(char s[], int maxDigits)
		{
		return s.arrayLength > 0 && s.arrayLength <= maxDigits && stringUtil.isNumeric(s)
		}

	// a layer count token value, 0 if not a number (a valid count is >= 1)
	int countValue(char s[])
		{
		if (!isNumber(s, 3)) return 0
		return s.intFromString()
		}

	// plain ifs on purpose: dnc 273 evaluates 'x && (a || b)' as false when a is true (in a bool assignment / if condition)
	bool isHexDigit(char c)
		{
		if (c >= 48 && c <= 57) return true
		if (c >= 65 && c <= 70) return true
		if (c >= 97 && c <= 102) return true
		return false
		}

	char hexValue(char c)
		{
		if (c <= 57) return c - 48
		if (c <= 70) return c - 55
		return c - 87
		}

	// percent-decode %XX: HTTP clients (python requests, browsers) send 'Weather Icons' as 'Weather%20Icons' and '|' as '%7C'.
	// Decoded here, not in the Rust front: a raw space in the request line would cut the path at Dana's request-line split.
	char[] urlDecode(char s[])
		{
		char result[] = new char[s.arrayLength]
		int n = 0
		for (int i = 0; i < s.arrayLength; i++)
			{
			if (s[i] == 37 && i + 2 < s.arrayLength && isHexDigit(s[i+1]) && isHexDigit(s[i+2]))
				{
				result[n] = (hexValue(s[i+1]) * 16) + hexValue(s[i+2])
				i += 2
				}
				else
				{
				result[n] = s[i]
				}
			n ++
			}
		return stringUtil.subString(result, 0, n)
		}

	// Parses + checks the request path and queues the task; returns null, or an error text for a 400 reply (was: throw, or an index
	// exception on a short path -> the client got no reply). Count token: "<n>" | "<k>+<n>" (PSC rebuild) | "<k>*<n>" (PSC pair), 1 <= k < n.
	char[] queueRequest(String subTokens[], TCPSocket socket, File fd, int bitrate, opt int queueTime)
		{
		if (subTokens.arrayLength < 10)
			return "path too short: /offload/show/<show>/<t0>/<t1>/<width>/<height>/<variant>/<style>/<count>/<layer|option>..."
		for (int i = 3; i <= 6; i++)
			{
			// braces needed: a braceless 'if (..) return "..$(x).."' breaks every later $() in the same function (dnc 273, tested)
			if (!isNumber(subTokens[i].string, 6))
				{
				return "t0, t1, width and height must be numbers, got '$(subTokens[i].string)'"
				}
			}

		RenderTask rt = new RenderTask(subTokens[2].string, subTokens[3].string.intFromString(), subTokens[4].string.intFromString(), subTokens[5].string.intFromString(), subTokens[6].string.intFromString(), bitrate, RenderTask.M_INIT, socket, fd)

		// PSC: count token "<n>" as before, "<k>+<n>" = roots 0..k-1 from the cached sub segment, k..n-1 rendered here,
		// "<k>*<n>" = pair (one render of n roots, also outputs the sub of roots 0..k-1)
		char count[] = urlDecode(subTokens[9].string)
		String pairParts[] = count.lsplit("*")
		String rebuildParts[] = count.lsplit("+")
		int k = 0
		int n = 0
		bool hasK = false
		if (pairParts.arrayLength == 2)
			{
			k = countValue(pairParts[0].string)
			n = countValue(pairParts[1].string)
			hasK = true
			}
			else if (rebuildParts.arrayLength == 2)
			{
			k = countValue(rebuildParts[0].string)
			n = countValue(rebuildParts[1].string)
			hasK = true
			}
			else
			{
			n = countValue(count)
			}
		// plain ifs: dnc 273 gets 'n < 1 || (hasK && (k < 1 || k >= n))' wrong ('0*4' passed)
		bool badCount = n < 1
		if (hasK)
			{
			if (k < 1) badCount = true
			if (k >= n) badCount = true
			}
		if (badCount)
			{
			return "bad layer count '$(count)': use <n>, <k>+<n> or <k>*<n> with 1 <= k < n"
			}

		RenderConfig rcfg = new RenderConfig(subTokens[7].string, subTokens[8].string, n)
		if (pairParts.arrayLength == 2)
			rcfg.pairLayerCount = k
			else if (hasK)
			rcfg.offloadLayerCount = k

		for (int i = 10; i < subTokens.arrayLength; i++)
			{
			//split by name/value, which is separated by | (a "%7C" from some clients is decoded to | first)
			char token[] = urlDecode(subTokens[i].string)
			String parts[] = token.lsplit("|")
			if (parts.arrayLength != 2)
				{
				return "malformed layer token '$(token)': use <layer>|<option>[,<option>...]"
				}
			String opts[] = parts[1].string.explode(",")
			rcfg.layers = new RenderLayer[](rcfg.layers, new RenderLayer(parts[0].string, opts))
			}

		rt.config = rcfg
		rt.t_arrive = cal.getMS()
		if (isset queueTime && queueTime > 0)
			rt.t_queue = queueTime
		out.println(" -- request queued (qTime: $(rt.t_queue)ms)")
		requests.add(rt)
		return null
		}

	void handleRequest(TCPSocket socket)
		{
		String headers[] = readHeaders(socket)

		// a connect + close without a request (readiness probe) -> nothing to answer
		if (headers == null || headers.arrayLength == 0)
			{
			socket.disconnect()
			return
			}

		String tokens[] = stringUtil.explode(headers[0].string, " ")

		if (tokens.arrayLength >= 2)
			{
			char cmd[] = tokens[0].string
			char rsc[] = tokens[1].string

			if (cmd == "GET")
				{
				if (rsc.startsWith("/offload/show/"))
					{
					String subTokens[] = rsc.explode("/")

					out.println("request '$(rsc)' arrived")

					int qTime = 0
					for (int i = 1; i < headers.arrayLength; i++)
						{
						if (headers[i].string.startsWith("X-Queue-Time"))
							{
							String qParts[] = headers[i].string.explode(":")
							if (qParts.arrayLength >= 2)
								qTime = stringUtil.trim(qParts[1].string).intFromString()
							}
						}
					char err[] = queueRequest(subTokens, socket, null, BITRATE_DEFAULT, qTime)
					if (err != null)
						{
						out.println(" -- bad request: $(err)")
						sendError(socket, 400, "Bad Request", err)
						}
					}
					else
					{
					sendError(socket, 404, "Not Found", "only /offload/show/... is served")
					}
				}
				else
				{
				sendError(socket, 400, "Bad Request", "only GET is served")
				}
			}
			else
			{
			sendError(socket, 400, "Bad Request", "malformed request line")
			}
		}

	// error reply (any non-200 answer: the Rust front forwards it; the main server never caches / coalesces a non-200 segment).
	// Always answering stops the front's resend-on-empty-reply loop for requests that can never succeed.
	void sendError(TCPSocket socket, int code, char reason[], char msg[])
		{
		char body[] = "$(msg)\n"
		socket.send("HTTP/1.0 $(code) $(reason)\r\n")
		socket.send("Server: Media Offload Server 0.1\r\n")
		socket.send("Content-length: $(body.arrayLength)\r\n")
		socket.send("Content-type: text/plain\r\n")
		socket.send("Connection: close\r\n")
		socket.send("\r\n")
		socket.send(body)
		socket.disconnect()
		}

	// a task that can not finish: error reply (listen) or message (direct). The caller then recycles Dana: an exception inside
	// Experience can leave its state (window, decoders) half built
	void failTask(RenderTask rt, int code, char reason[], char msg[])
		{
		out.println("\n -- request failed: $(code) $(msg)")
		if (rt.socket != null) sendError(rt.socket, code, reason, msg)
		if (rt.file != null) rt.file.close()
		pending.remove(rt)
		}

	void serverThread(TCPServerSocket server)
		{
		while (!quit)
			{
			TCPSocket s = new TCPSocket()

			if (s.accept(server))
				handleRequest(s)
			}
		}
}