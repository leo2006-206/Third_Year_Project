# ==============================================================================
# Dockerfile for OBM Main Server (Rust Main Server on Port 7000)
# ==============================================================================
FROM ubuntu:22.04

# Prevent interactive dialogs during apt installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential runtime certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory to the OBM application root
WORKDIR /app/obm

# 1. Create mount directories for runtime volumes (assets and shows)
RUN mkdir -p /app/obm/shows /app/obm/assets

# 3. Copy pre-compiled Rust main_server binary
COPY --chmod=755 target/release/main_server /usr/local/bin/main_server

# 4. Cost model for the mct policy (stat_predict/export.py output; rebuild the image after re-exporting).
#    Override the paths with OBM_COST_COEF / OBM_COST_FEATURES (e.g. a mounted newer export)
COPY stat_predict/coef.csv stat_predict/features.csv /app/stat_predict/

# 5. Copy entrypoint script for clean SIGINT / Ctrl+C handling
COPY --chmod=755 servers_container/main_server/entrypoint.sh /usr/local/bin/entrypoint.sh

# Expose Port 7000 for Rust Main Server
EXPOSE 7000

# Use entrypoint script to cleanly forward SIGINT (Ctrl+C) and SIGTERM
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# Cluster CSV path inside the container (run_sh.sh mounts the host CSV here)
CMD ["/app/cluster_endpoint.csv"]
