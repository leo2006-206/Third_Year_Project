# ==============================================================================
# Dockerfile for OBM Main Server (Rust Main Server on Port 7000)
# ==============================================================================
FROM ubuntu:22.04

# Prevent interactive dialogs during apt installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential runtime certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory to the OBM application root
WORKDIR /app/obm

# 1. Copy media assets layer first (cached permanently: ~2GB)
COPY obm/assets/ /app/obm/assets/

# 2. Copy show definitions and UI assets needed by the Rust server
COPY obm/shows/ /app/obm/shows/
COPY obm/std_ui/ /app/obm/std_ui/

# 3. Copy pre-compiled Rust main_server binary
COPY --chmod=755 servers_rust/target/release/main_server /usr/local/bin/main_server

# 4. Copy entrypoint script for clean SIGINT / Ctrl+C handling
COPY --chmod=755 servers_container/main_server/entrypoint.sh /usr/local/bin/entrypoint.sh

# Expose Port 7000 for Rust Main Server
EXPOSE 7000

# Use entrypoint script to cleanly forward SIGINT (Ctrl+C) and SIGTERM
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
