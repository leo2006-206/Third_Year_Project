# Build context for servers_container/main_server/dockerfile
# (the offload image uses servers_container/offload_server/dockerfile.dockerignore)

# Git directories
.git
**/.git

# Documentation, planning, scratch
docs
docs_resource
reports
.old
.ai
temp
stat
servers_benchmark/sequences

# Scripts & configs not needed in container
local_host.txt
set_ssh.sh

# Large media: mounted at runtime as volumes, never baked into images
obm

# Rust build output: only the release binaries are copied into images
target
!target/release/main_server
!target/release/offload_server
